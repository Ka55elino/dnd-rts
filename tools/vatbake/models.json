{
  "$comment": "What to bake. source is relative to the repo root; output goes to frontend/public/models/<id>/. clips: name -> source clip in the glb, or a procedural generator from clips.mjs (\"@swing\", \"@bow\", \"@die\", grab3d rig only). footBone: bone that measures the stride (default footL). reverse: play the source clip backwards (unbrace = brace reversed). albedo: optional, default textures/<skin>_albedo.png next to the source.",
  "fps": 15,
  "models": [
    {
      "id": "swordsman",
      "source": "art/source/empire/units/swordsman/central.glb",
      "teamMaterials": [
        "base_team"
      ],
      "footBone": "mixamorigLeftFoot",
      "clips": {
        "idle": {
          "from": "idle",
          "loop": true
        },
        "walk": {
          "from": "run",
          "loop": true
        },
        "run": {
          "from": "run",
          "loop": true
        },
        "attack": {
          "from": "attack",
          "loop": false
        },
        "die": {
          "from": "die",
          "loop": false
        },
        "brace": {
          "from": "brace",
          "loop": false
        },
        "unbrace": {
          "from": "brace",
          "loop": false,
          "reverse": true
        },
        "walk_brace": {
          "from": "walk_brace",
          "loop": true,
          "reverse": true
        }
      }
    },
    {
      "id": "ranger",
      "source": "art/source/grab3d/ranger.glb",
      "teamMaterials": [
        "hat_primary",
        "top_primary",
        "bottom_accent"
      ],
      "clips": {
        "idle": {
          "from": "idle",
          "loop": true
        },
        "walk": {
          "from": "walk",
          "loop": true
        },
        "run": {
          "from": "run",
          "loop": true
        },
        "attack": {
          "from": "@bow",
          "loop": false
        },
        "die": {
          "from": "@die",
          "loop": false
        }
      }
    }
  ]
}
